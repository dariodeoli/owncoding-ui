{
  "name": "owncoding-ui",
  "version": "0.68.13",
  "description": "Componentes, objetos y reglas de interfaz reutilizables entre las apps de OwnCoding (MobOS, ScaleOS, LedBox, PagaYa).",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./ia": {
      "types": "./dist/ia.d.ts",
      "default": "./dist/ia.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./financial": {
      "types": "./dist/financial.d.ts",
      "default": "./dist/financial.js"
    },
    "./financial-metadata": {
      "types": "./dist/financial-metadata.d.ts",
      "default": "./dist/financial-metadata.js"
    },
    "./app-identity": {
      "types": "./dist/app-identity.d.ts",
      "default": "./dist/app-identity.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./tailwind-preset": {
      "types": "./types/tailwind-preset.d.ts",
      "default": "./tailwind-preset.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "dist",
    "src",
    "!src/**/* 2.*",
    "!src/**/* 3.*",
    "types",
    "docs",
    "!docs/**/* 2.*",
    "!docs/**/* 3.*",
    "!docs/qa",
    "CHANGELOG.md",
    "tailwind-preset.js",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "gallery:dev": "node scripts/gallery-status.mjs && vite --config vite.gallery.config.js",
    "gallery:check": "node scripts/gallery-check.mjs && node scripts/blog-check.mjs",
    "gallery:build": "node scripts/verificar-contexto-build.mjs && node scripts/gallery-status.mjs && vite build --config vite.gallery.config.js && node scripts/gallery-performance-check.mjs && node scripts/blog-build.mjs",
    "readme:check": "node scripts/readme-check.mjs",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p test/consumer/tsconfig.json",
    "test:package": "node scripts/package-smoke.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "financial-assets:check": "node scripts/financial-assets-check.mjs",
    "blog:check": "node scripts/blog-check.mjs",
    "check:contexto": "node scripts/verificar-contexto-build.mjs"
  },
  "peerDependencies": {
    "qrcode": ">=1.5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "clsx": "^2.1.1",
    "libphonenumber-js": "1.13.14",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
